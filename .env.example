# GitHub token for GET /events and PR body/files. Required for github:events, github:pull, Connect, and reason.
GITHUB_TOKEN=

# Optional. Max opened PRs Connect produces per 30s sweep (default 1).
# CONNECT_BATCH_LIMIT=1

# Host Ollama (not in Docker).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b

