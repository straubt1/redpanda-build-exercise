# GitHub token for GET /events and PR body/files. Required for github:events, github:pull, Connect, and reason.
GITHUB_TOKEN=

# Host Ollama (not in Docker). Optional; reason defaults to http://127.0.0.1:11434
# Compose sets OLLAMA_URL=http://host.docker.internal:11434 on the reason service.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b

