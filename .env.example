# GitHub token for GET /events and PR body/files. Required for github:events, github:pull, Connect, and the app.
GITHUB_TOKEN=

# Host Ollama (not in Docker). Optional; app defaults to http://127.0.0.1:11434
# Compose sets OLLAMA_URL=http://host.docker.internal:11434 on the app service.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b

